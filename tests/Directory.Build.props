<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    xunit.analyzers is a PackageReference rather than a global one because it only
    makes sense where xunit is used. Faber.Testing.Shared is a library that holds
    xunit-based helpers, so it gets the analyzers as well.
  -->
  <ItemGroup>
    <PackageReference Include="xunit.analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

</Project>
