<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <AddRazorSupportForMVC>true</AddRazorSupportForMVC>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Playwright" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Faber.Modules.Documents.PublicApi\Faber.Modules.Documents.PublicApi.csproj"/>
        <ProjectReference Include="..\..\Resumes\Faber.Modules.Resumes.Domain\Faber.Modules.Resumes.Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\TemplateStrings.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>TemplateStrings.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\TemplateStrings.Designer.cs">
            <AutoGen>True</AutoGen>
            <DesignTime>True</DesignTime>
            <DependentUpon>TemplateStrings.resx</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>
