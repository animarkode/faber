<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints.Messaging.Core" Version="8.3.0" />
        <PackageReference Include="FluentEmail.Core" Version="3.0.2"/>
        <PackageReference Include="FluentEmail.Razor" Version="3.0.2"/>
        <PackageReference Include="FluentEmail.Smtp" Version="3.0.2"/>
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.31" />
        <PackageReference Include="Microsoft.AspNetCore.Hosting.Abstractions" Version="2.3.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Resend.FluentEmail" Version="0.16.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Auth\Faber.Modules.Auth.PublicApi\Faber.Modules.Auth.PublicApi.csproj"/>
        <ProjectReference Include="..\..\Documents\Faber.Modules.Documents.PublicApi\Faber.Modules.Documents.PublicApi.csproj"/>
        <ProjectReference Include="..\..\Identity\Faber.Modules.Identity.PublicApi\Faber.Modules.Identity.PublicApi.csproj"/>
        <ProjectReference Include="..\Faber.Modules.Notifications.PublicApi\Faber.Modules.Notifications.PublicApi.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The transports (ResendEmailSender, FluentEmailSender) are internal on purpose: they must
             only be reachable through the ThrottledEmailSender decorator, never injected directly.
             Widening them to public to make them testable would remove exactly the guard the modifier
             exists for, so the unit test assembly is named as a friend instead. -->
        <InternalsVisibleTo Include="Faber.Modules.Notifications.Application.UnitTests"/>
        <InternalsVisibleTo Include="Faber.Modules.Auth.Application.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

</Project>
