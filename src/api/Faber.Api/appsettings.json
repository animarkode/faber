{
  "ConnectionStrings": {
    "FaberHost": "https://$APP_DOMAIN$"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ResumeLimits": {
    "Limits": {
      "Regular": 2147483647,
      "Premium": 2147483647
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "RetryAfterFallbackSeconds": 60,
    "GlobalAnonymous": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "GlobalAuthenticated": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "AuthSession": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "AuthExternal": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "AuthenticatedDefault": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "ExpensiveResource": {
      "PermitLimit": 2,
      "QueueLimit": 2
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Keycloak": {
    "BaseUrl": "https://keycloak.$APP_DOMAIN$",
    "Issuer": "https://keycloak.$APP_DOMAIN$/realms/faber",
    "Audience": "faber-api",
    "ClientId": "faber-api",
    "Realm": "faber"
  },
  "Kestrel": {
    "Endpoints": {
      "Health": {
        "Url": "http://0.0.0.0:7107"
      },
      "Https": {
        "Url": "https://0.0.0.0:7106"
      }
    }
  }
}
